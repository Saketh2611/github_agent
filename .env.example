# AWS Bedrock
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=openai.gpt-oss-20b-1:0

# Groq
GROQ_MODEL=openai/gpt-oss-120b

# SQLite (defaults to a persistent database in the DB folder)
# For an in-memory database that resets on restart, use sqlite://
DATABASE_URL=sqlite:///DB/github_agent.sqlite3

# GitHub
GITHUB_TOKEN=ghp_your-personal-access-token
# Optional: auto-detected from git remote if omitted. Works with org/private repos.
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=
